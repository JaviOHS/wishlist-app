<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lista de Deseos</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <style>
    [x-cloak] { display: none; }
    body { font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">

  <div class="flex flex-col lg:flex-row min-h-screen">

    <!-- SIDEBAR: Formulario -->
    <aside class="lg:w-[380px] lg:min-h-screen bg-white border-b lg:border-b-0 lg:border-r border-slate-100 p-8 flex flex-col gap-8 flex-shrink-0">

      <!-- Marca -->
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700">
          <i class="ti ti-heart text-lg"></i>
        </div>
        <div>
          <h1 class="text-[17px] font-medium leading-tight">Lista de Deseos</h1>
          <p class="text-[12px] text-slate-400 mt-0.5">Tus metas, organizadas</p>
        </div>
      </div>

      <!-- Formulario -->
      <form action="/agregar" method="POST" class="flex flex-col gap-5">
        <span class="text-[11px] font-medium uppercase tracking-widest text-slate-400">Nuevo deseo</span>

        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] text-slate-500" for="nombre">Nombre</label>
          <input id="nombre" type="text" name="nombre" placeholder="¿Qué deseas?" required
            class="text-sm px-3 py-2.5 border border-slate-200 rounded-lg bg-slate-50 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="flex flex-col gap-1.5">
            <label class="text-[13px] text-slate-500" for="precio">Precio</label>
            <input id="precio" type="number" name="precio" placeholder="0.00" step="0.01" required
              class="text-sm px-3 py-2.5 border border-slate-200 rounded-lg bg-slate-50 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition">
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-[13px] text-slate-500" for="prioridad">Prioridad</label>
            <input id="prioridad" type="text" name="prioridad" placeholder="Alta, Media, Baja"
              class="text-sm px-3 py-2.5 border border-slate-200 rounded-lg bg-slate-50 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition">
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] text-slate-500" for="descripcion">
            Descripción <span class="text-[11px] opacity-50">(opcional)</span>
          </label>
          <textarea id="descripcion" name="descripcion" rows="4"
            placeholder="Agrega detalles, enlaces, notas…"
            class="text-sm px-3 py-2.5 border border-slate-200 rounded-lg bg-slate-50 resize-none focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition"></textarea>
        </div>

        <div class="flex flex-col gap-2 mt-1">
          <button type="submit"
            class="flex items-center justify-center gap-2 bg-blue-700 hover:bg-blue-800 text-white text-sm font-medium py-2.5 rounded-lg transition">
            <i class="ti ti-plus"></i> Agregar deseo
          </button>
          <button type="reset"
            class="text-sm text-slate-500 py-2.5 border border-slate-200 rounded-lg hover:bg-slate-50 transition">
            Limpiar campos
          </button>
        </div>
      </form>

      <div class="mt-auto pt-6 border-t border-slate-100">
        <p class="text-[11px] text-slate-400 leading-relaxed">
          <i class="ti ti-info-circle align-middle mr-1"></i>
          Los deseos completados se marcan automáticamente al confirmarlos.
        </p>
      </div>
    </aside>

    <!-- MAIN: Lista de deseos -->
    <main class="flex-1 p-8 overflow-y-auto flex flex-col gap-5">

      <!-- Encabezado -->
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h2 class="text-[15px] font-medium">Mis deseos</h2>
        <div class="flex gap-2">
          <span class="text-[12px] px-3 py-1 rounded-full bg-blue-50 text-blue-700">
            <i class="ti ti-list align-middle mr-1"></i><%= deseos.length %> total
          </span>
          <span class="text-[12px] px-3 py-1 rounded-full bg-green-50 text-green-700">
            <i class="ti ti-check align-middle mr-1"></i><%= deseos.filter(d => d.completado).length %> completados
          </span>
        </div>
      </div>

      <!-- Cards -->
      <% if (!deseos || deseos.length === 0) { %>
        <div class="flex flex-col items-center justify-center gap-3 py-24 text-slate-300 text-center">
          <i class="ti ti-heart-off text-5xl"></i>
          <p class="text-sm">Aún no tienes deseos. ¡Agrega el primero!</p>
        </div>
      <% } else { %>
        <ul class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
          <% deseos.forEach(deseo => { %>
            <li class="bg-white border border-slate-100 rounded-xl p-5 flex flex-col gap-3 hover:border-slate-200 transition">
              <div class="flex items-start justify-between gap-2">
                <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center text-blue-700 flex-shrink-0">
                  <i class="ti ti-star text-lg"></i>
                </div>
                <span class="text-[11px] font-medium px-2.5 py-1 rounded-full <%= deseo.completado ? 'bg-green-50 text-green-700' : 'bg-amber-50 text-amber-700' %>">
                  <%= deseo.completado ? 'Completado' : 'Pendiente' %>
                </span>
              </div>
              <p class="text-sm font-medium leading-snug <%= deseo.completado ? 'line-through text-slate-400' : '' %>"><%= deseo.nombre %></p>
              <% if (deseo.descripcion) { %>
                <p class="text-xs text-slate-400 leading-relaxed"><%= deseo.descripcion %></p>
              <% } %>
              <div class="flex items-center justify-between pt-2 border-t border-slate-100 mt-auto">
                <span class="text-[15px] font-medium">$<%= (Number(deseo.precio) || 0).toFixed(2) %></span>
                <div class="flex items-center gap-2">
                  <span class="text-[11px] px-2 py-1 rounded-full bg-slate-100 text-slate-700">
                    <%= deseo.prioridad || 'Media' %>
                  </span>
                  <span class="text-[11px] text-slate-300">
                    <%= deseo.fechaCreada ? new Date(deseo.fechaCreada).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) : '' %>
                  </span>
                  <form action="/completar/<%= deseo._id %>" method="POST" title="<%= deseo.completado ? 'Marcar como pendiente' : 'Marcar como completado' %>">
                    <button type="submit"
                      class="text-slate-300 hover:text-green-500 border border-transparent hover:bg-green-50 rounded-lg p-1.5 transition">
                      <i class="ti ti-check text-sm"></i>
                    </button>
                  </form>

                  <button type="button"
                    class="edit-trigger text-slate-300 hover:text-blue-600 border border-transparent hover:border-blue-200 hover:bg-blue-50 rounded-lg p-1.5 transition"
                    data-action="/editar/<%= deseo._id %>"
                    data-nombre="<%= deseo.nombre %>"
                    data-precio="<%= deseo.precio %>"
                    data-prioridad="<%= deseo.prioridad || 'Media' %>"
                    data-descripcion="<%= deseo.descripcion || '' %>">
                    <i class="ti ti-pencil text-sm"></i>
                  </button>

                  <form action="/eliminar/<%= deseo._id %>" method="POST" class="delete-form">
                    <button type="button"
                      class="delete-trigger text-slate-300 hover:text-red-500 border border-transparent hover:border-red-200 hover:bg-red-50 rounded-lg p-1.5 transition"
                      data-action="/eliminar/<%= deseo._id %>"
                      data-nombre="<%= deseo.nombre %>"
                      data-precio="<%= (Number(deseo.precio) || 0).toFixed(2) %>"
                      data-prioridad="<%= deseo.prioridad || 'Media' %>"
                      data-descripcion="<%= deseo.descripcion || 'Sin descripción' %>"
                      data-estado="<%= deseo.completado ? 'Completado' : 'Pendiente' %>">
                      <i class="ti ti-trash text-sm"></i>
                    </button>
                  </form>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>

    </main>
  </div>

  <div id="delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/50 px-4">
    <div class="w-full max-w-md rounded-2xl bg-white shadow-2xl border border-slate-100 overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-start gap-3">
        <div class="w-10 h-10 rounded-full bg-red-50 text-red-600 flex items-center justify-center flex-shrink-0">
          <i class="ti ti-trash text-xl"></i>
        </div>
        <div class="min-w-0">
          <h3 class="text-base font-semibold text-slate-900">Eliminar deseo</h3>
          <p class="text-sm text-slate-500 mt-1">Revisa la información antes de confirmar la baja.</p>
        </div>
      </div>

      <div class="p-5 space-y-3 text-sm text-slate-600">
        <div class="grid grid-cols-1 gap-3 rounded-xl bg-slate-50 p-4 border border-slate-100">
          <div>
            <span class="block text-[11px] uppercase tracking-widest text-slate-400">Nombre</span>
            <p id="delete-modal-nombre" class="mt-1 font-medium text-slate-900"></p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <span class="block text-[11px] uppercase tracking-widest text-slate-400">Precio</span>
              <p id="delete-modal-precio" class="mt-1 font-medium text-slate-900"></p>
            </div>
            <div>
              <span class="block text-[11px] uppercase tracking-widest text-slate-400">Prioridad</span>
              <p id="delete-modal-prioridad" class="mt-1 font-medium text-slate-900"></p>
            </div>
          </div>
          <div>
            <span class="block text-[11px] uppercase tracking-widest text-slate-400">Estado</span>
            <p id="delete-modal-estado" class="mt-1 font-medium text-slate-900"></p>
          </div>
          <div>
            <span class="block text-[11px] uppercase tracking-widest text-slate-400">Descripción</span>
            <p id="delete-modal-descripcion" class="mt-1 text-slate-600 whitespace-pre-wrap"></p>
          </div>
        </div>
      </div>

      <div class="p-5 border-t border-slate-100 flex items-center justify-end gap-3">
        <button id="delete-modal-cancel" type="button"
          class="px-4 py-2 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 transition">
          Cancelar
        </button>
        <form id="delete-modal-form" method="POST">
          <button type="submit"
            class="px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700 transition">
            Eliminar
          </button>
        </form>
      </div>
    </div>
  </div>

  <div id="edit-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/50 px-4">
    <div class="w-full max-w-md rounded-2xl bg-white shadow-2xl border border-slate-100 overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-start gap-3">
        <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">
          <i class="ti ti-pencil text-xl"></i>
        </div>
        <div class="min-w-0">
          <h3 class="text-base font-semibold text-slate-900">Editar deseo</h3>
          <p class="text-sm text-slate-500 mt-1">Modifica los datos y guarda los cambios.</p>
        </div>
      </div>

      <form id="edit-modal-form" method="POST" class="p-5 space-y-4">
        <div>
          <label for="edit-nombre" class="block text-[11px] uppercase tracking-widest text-slate-400">Nombre</label>
          <input id="edit-nombre" name="nombre" type="text" required
            class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="edit-precio" class="block text-[11px] uppercase tracking-widest text-slate-400">Precio</label>
            <input id="edit-precio" name="precio" type="number" step="0.01" required
              class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100">
          </div>
          <div>
            <label for="edit-prioridad" class="block text-[11px] uppercase tracking-widest text-slate-400">Prioridad</label>
            <input id="edit-prioridad" name="prioridad" type="text"
              class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100">
          </div>
        </div>

        <div>
          <label for="edit-descripcion" class="block text-[11px] uppercase tracking-widest text-slate-400">Descripción</label>
          <textarea id="edit-descripcion" name="descripcion" rows="4"
            class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm resize-none focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100"></textarea>
        </div>

        <div class="flex items-center justify-end gap-3 pt-1 border-t border-slate-100">
          <button id="edit-modal-cancel" type="button"
            class="px-4 py-2 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 transition">
            Cancelar
          </button>
          <button type="submit"
            class="px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition">
            Guardar cambios
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const deleteModal = document.getElementById('delete-modal');
    const deleteModalForm = document.getElementById('delete-modal-form');
    const deleteModalCancel = document.getElementById('delete-modal-cancel');
    const deleteModalNombre = document.getElementById('delete-modal-nombre');
    const deleteModalPrecio = document.getElementById('delete-modal-precio');
    const deleteModalPrioridad = document.getElementById('delete-modal-prioridad');
    const deleteModalDescripcion = document.getElementById('delete-modal-descripcion');
    const deleteModalEstado = document.getElementById('delete-modal-estado');
    const editModal = document.getElementById('edit-modal');
    const editModalForm = document.getElementById('edit-modal-form');
    const editModalCancel = document.getElementById('edit-modal-cancel');
    const editNombre = document.getElementById('edit-nombre');
    const editPrecio = document.getElementById('edit-precio');
    const editPrioridad = document.getElementById('edit-prioridad');
    const editDescripcion = document.getElementById('edit-descripcion');

    function openDeleteModal(button) {
      deleteModalForm.action = button.dataset.action;
      deleteModalNombre.textContent = button.dataset.nombre || '';
      deleteModalPrecio.textContent = `$${button.dataset.precio || '0.00'}`;
      deleteModalPrioridad.textContent = button.dataset.prioridad || 'Media';
      deleteModalDescripcion.textContent = button.dataset.descripcion || 'Sin descripción';
      deleteModalEstado.textContent = button.dataset.estado || 'Pendiente';
      deleteModal.classList.remove('hidden');
      deleteModal.classList.add('flex');
    }

    function closeDeleteModal() {
      deleteModal.classList.add('hidden');
      deleteModal.classList.remove('flex');
      deleteModalForm.action = '';
    }

    function openEditModal(button) {
      editModalForm.action = button.dataset.action;
      editNombre.value = button.dataset.nombre || '';
      editPrecio.value = button.dataset.precio || '0';
      editPrioridad.value = button.dataset.prioridad || 'Media';
      editDescripcion.value = button.dataset.descripcion || '';
      editModal.classList.remove('hidden');
      editModal.classList.add('flex');
    }

    function closeEditModal() {
      editModal.classList.add('hidden');
      editModal.classList.remove('flex');
      editModalForm.action = '';
    }

    document.querySelectorAll('.delete-trigger').forEach(button => {
      button.addEventListener('click', () => openDeleteModal(button));
    });

    document.querySelectorAll('.edit-trigger').forEach(button => {
      button.addEventListener('click', () => openEditModal(button));
    });

    deleteModalCancel.addEventListener('click', closeDeleteModal);
    deleteModal.addEventListener('click', event => {
      if (event.target === deleteModal) closeDeleteModal();
    });
    editModalCancel.addEventListener('click', closeEditModal);
    editModal.addEventListener('click', event => {
      if (event.target === editModal) closeEditModal();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !deleteModal.classList.contains('hidden')) {
        closeDeleteModal();
      }
      if (event.key === 'Escape' && !editModal.classList.contains('hidden')) {
        closeEditModal();
      }
    });
  </script>

</body>
</html>